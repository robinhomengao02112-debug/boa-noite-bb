{
  "name": "live-tiktok-starter",
  "version": "0.1.0",
  "private": true,
  "description": "Live interativa automatica para TikTok: jogos, controlador 24h, OBS automatico, painel e aprendizado.",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "sim": "node src/server.js --simulate",
    "controlador": "node src/controller.js",
    "controlador:sim": "node src/controller.js --simulate",
    "setup": "node scripts/setup.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "express": "^5.3.0",
    "obs-websocket-js": "^5.0.8",
    "socket.io": "^4.8.4",
    "tiktok-live-connector": "^2.5.0"
  }
}
